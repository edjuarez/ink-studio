{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "sophie-art-tattoo",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-09-15",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "sophie_art_tattoo_db",
			"database_name": "sophie-art-tattoo-db",
			"database_id": "0aa5a8cd-6bc5-4365-be16-ed054c8ed882"
		}
	]
}